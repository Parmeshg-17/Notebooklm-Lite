# Application
PROJECT_NAME="NotebookLM Lite API"
VERSION="1.4.0"
API_V1_STR="/api/v1"
DEBUG=true

# Security
SECRET_KEY="development_secret_key_change_in_production_min_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite+aiosqlite:///./notebooklm.db"

# Google Gemini API
GOOGLE_API_KEY=""
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# Qdrant Vector Database
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="notebook_documents"

# Ingestion & Retrieval Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
RAG_SCORE_THRESHOLD=0.20

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=52428800  # 50 MB

# LangGraph & MCP Agent Configuration
AGENT_WORKFLOW_ENABLED=true
AGENT_MAX_RETRIES=2
MCP_SERVER_NAME="notebooklm-mcp"

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:5174", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:5174"]

# AWS & Cloud Storage (Phase 6)
ENVIRONMENT="production"
AWS_REGION="ap-south-1"
STORAGE_BACKEND="s3"  # "local" or "s3"
S3_BUCKET_NAME=""
PRESIGNED_URL_EXPIRE_SECONDS=900
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true
ALLOW_DEMO_FALLBACK=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
