# ============================================================
# NOTEBOOKLM LITE — Environment Configuration Example
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ----- Database (PostgreSQL + pgvector) -----
# Note: Host port 5433 maps to container 5432 to prevent conflict with local Postgres.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/notebooklm
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5433/notebooklm

# ----- Redis (Queue & Caching) -----
REDIS_URL=redis://localhost:6379/0

# ----- Object Storage (S3 / LocalStack / Local Filesystem) -----
S3_ENDPOINT=http://localhost:4566
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=notebooklm-documents
S3_USE_SSL=false

# ----- Embedding Provider -----
# Options: openai | gemini | local
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# ----- LLM Provider -----
# Options: openai | gemini
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-openai-api-key-here

# Provider-Specific API Keys
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ----- Reranker (Optional) -----
# Options: none | cohere | local
RERANKER_PROVIDER=none
RERANKER_MODEL=rerank-english-v3.0
COHERE_API_KEY=your-cohere-api-key-here

# ----- Chunking Strategy -----
CHUNK_TOKEN_BUDGET=512
CHUNK_OVERLAP_TOKENS=64

# ----- Hybrid Retrieval (RRF) -----
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RRF_K=60
FINAL_TOP_K=5

# ----- Application Runtime -----
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# ----- Frontend -----
NEXT_PUBLIC_API_URL=http://localhost:8000
